{
  "name": "cgi-andaluciarp",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "durable_objects": { "bindings": [{ "name": "CGI", "class_name": "CGI" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CGI"] }],
  "observability": { "enabled": true }
  // Si te quedas sin acceso a la cuenta dev: añade  "vars": { "DEV_RESET": "1" }  , despliega, entra, y quítalo.
  //
  // COPIAS EXTERNAS DIARIAS A R2 (OPCIONAL, desactivado). Las copias internas diarias ya funcionan sin configurar nada.
  // Para guardar además una copia fuera de la base de datos: 1) npx wrangler r2 bucket create cgi-backups
  // 2) quita las // del principio de la línea de abajo (ya lleva la coma delante)   3) npx wrangler deploy
  // , "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "cgi-backups" }]
}
